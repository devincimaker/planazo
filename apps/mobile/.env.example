EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Crash reporting. Blank turns Sentry off; dev clients never report either way.
# A local Release build with a DSN reports to the 'development' environment.
EXPO_PUBLIC_SENTRY_DSN=
# Local builds have no Sentry auth token, and the upload build phase fails the
# whole build without one. EAS builds get the SENTRY_AUTH_TOKEN secret instead.
SENTRY_DISABLE_AUTO_UPLOAD=true
IOS_SIMULATOR=iPhone 16 Pro
EXPO_PORT=8081
