{
  "expo": {
    "name": "Planazo",
    "slug": "planazo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "planazo",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8730e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.planazo.app",
      "appleTeamId": "D4ADFZ3XZL",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f8730e"
      },
      "package": "com.planazo.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Planazo uses your photo library for your profile photo and for screenshots you attach to feedback.",
          "cameraPermission": "Planazo uses the camera to take a profile photo."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39c24636-0b8b-4ffb-b3a4-f5f40eb32ac2"
      }
    }
  }
}
