{
  "name": "planazo",
  "private": true,
  "scripts": {
    "dev": "turbo dev --ui tui",
    "build": "turbo build",
    "lint": "turbo lint",
    "knip": "knip --include files,dependencies,unlisted,binaries",
    "knip:all": "knip",
    "dev:mobile": "turbo dev --filter=mobile",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "db:diff": "npx supabase db diff",
    "db:migrate:new": "npx supabase migration new",
    "db:gen:types": "npx supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "db:seed:demo": "node scripts/seed-demo-data.mjs",
    "assets:brand": "node scripts/build-brand-assets.mjs",
    "assets:screenshots": "node scripts/build-store-screenshots.mjs",
    "test": "turbo test",
    "test:integration": "pnpm --filter @planazo/integration-tests test",
    "wt:new": "bash scripts/worktree-create.sh",
    "wt:db:reset": "bash scripts/worktree-db-reset.sh",
    "wt:setup": "bash scripts/worktree-setup.sh",
    "wt:start": "bash scripts/worktree-start.sh",
    "wt:list": "bash scripts/worktree-list.sh",
    "wt:rm": "bash scripts/worktree-remove.sh"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "dotenv": "^16.4.5",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "knip": "^6.31.0",
    "turbo": "^2.3.0",
    "typescript-eslint": "^8"
  },
  "packageManager": "pnpm@9.15.1"
}
